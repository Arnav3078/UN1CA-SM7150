From f26d40abbf935b2a81064dfff5f7a1263f9f6a41 Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Mon, 13 Oct 2025 14:44:50 +0200
Subject: [PATCH] Add side fingerprint sensor support

---
 smali/com/android/systemui/LsRune.smali       |  2 +-
 .../com/android/systemui/util/DeviceType.smali | 20 ++++++++++----------
 2 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/smali/com/android/systemui/LsRune.smali b/smali/com/android/systemui/LsRune.smali
index 182a4a41b2..4997ee6901 100644
--- a/smali/com/android/systemui/LsRune.smali
+++ b/smali/com/android/systemui/LsRune.smali
@@ -738,5 +738,5 @@
     sput-boolean v0, Lcom/android/systemui/LsRune;->SECURITY_UNPACK:Z
 
-    sput-boolean v3, Lcom/android/systemui/LsRune;->SECURITY_FINGERPRINT_IN_DISPLAY:Z
+    sput-boolean v2, Lcom/android/systemui/LsRune;->SECURITY_FINGERPRINT_IN_DISPLAY:Z
 
     const-string v0, "SEC_FLOATING_FEATURE_BIOAUTH_CONFIG_FINGERPRINT_FEATURES"
diff --git a/smali_classes4/com/android/systemui/util/DeviceType.smali b/smali_classes4/com/android/systemui/util/DeviceType.smali
index 697d363c16..36376ea720 100644
--- a/smali_classes4/com/android/systemui/util/DeviceType.smali
+++ b/smali_classes4/com/android/systemui/util/DeviceType.smali
@@ -481,20 +481,20 @@
     const/4 v1, -0x1
 
-    const/4 v2, 0x1
+    const/4 v2, 0x0
 
     if-ne v0, v1, :cond_0
 
     sput v2, Lcom/android/systemui/util/DeviceType;->supportInDisplayFingerprint:I
 
     :cond_0
     sget v0, Lcom/android/systemui/util/DeviceType;->supportInDisplayFingerprint:I
 
-    if-ne v0, v2, :cond_1
+    const/4 v1, 0x1
 
-    return v2
+    if-ne v0, v1, :cond_1
+
+    return v1
 
     :cond_1
-    const/4 v0, 0x0
-
-    return v0
+    return v2
 .end method
@@ -898,20 +898,20 @@
     const/4 v1, -0x1
 
-    const/4 v2, 0x0
+    const/4 v2, 0x1
 
     if-ne v0, v1, :cond_0
 
     sput v2, Lcom/android/systemui/util/DeviceType;->supportSideFingerprint:I
 
     :cond_0
     sget v0, Lcom/android/systemui/util/DeviceType;->supportSideFingerprint:I
 
-    const/4 v1, 0x1
-
-    if-ne v0, v1, :cond_1
+    if-ne v0, v2, :cond_1
 
-    return v1
+    return v2
 
     :cond_1
-    return v2
+    const/4 v0, 0x0
+
+    return v0
 .end method
