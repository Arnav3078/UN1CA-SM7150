#!/system/bin/sh
# UN1CA Adreno 618 GPU Tuning Service for SM7150
IPC="/data/misc/unica_gpu"
REQ="$IPC/requests/request.json"
RESP="$IPC/responses/response.json"
BASE="/cache/unica-gpu"

mkdir -p "$IPC/requests" "$IPC/responses" "$IPC/archives" "$BASE" 2>/dev/null
chmod 0777 "$IPC" "$IPC/requests" "$IPC/responses" "$BASE" 2>/dev/null

[ ! -f "$REQ" ] && exit 0

REQ_ID=$(grep -oE '"[0-9a-f-]{36}"' "$REQ" | head -n 1 | tr -d '"')
[ -z "$REQ_ID" ] && REQ_ID=$(getprop sys.unica.gpu.request)
[ -z "$REQ_ID" ] && REQ_ID="00000000-0000-0000-0000-000000000000"

OP=$(grep -oE '"(status|backup|restart|renew|exported|apply|apply2|restore)"' "$REQ" | tr -d '"' | tail -n 1)
[ -z "$OP" ] && OP="status"

CUR_HASH="adreno618sm7150unica"

case "$OP" in
    backup)
        mkdir -p "$BASE" 2>/dev/null
        echo "$CUR_HASH" > "$BASE/original.sha256"
        echo "$CUR_HASH" > "$BASE/rollback.sha256"
        touch "$BASE/rollback.zip"
        chmod 0666 "$BASE/rollback.zip" "$BASE/rollback.sha256" 2>/dev/null
        ;;
    exported)
        echo "$CUR_HASH" > "$BASE/exported"
        ;;
    apply|apply2)
        # Apply requested max GPU clock if specified
        REQ_MAX=$(grep -oE '[0-9]{8,10}' "$REQ" | head -n 1)
        if [ -n "$REQ_MAX" ] && [ "$REQ_MAX" -ge 180000000 ] && [ "$REQ_MAX" -le 800000000 ]; then
            echo "$REQ_MAX" > /sys/class/kgsl/kgsl-3d0/max_gpuclk 2>/dev/null
            setprop persist.sys.unica.gpu.max_clk "$REQ_MAX"
        fi
        ;;
    restore)
        echo 700000000 > /sys/class/kgsl/kgsl-3d0/max_gpuclk 2>/dev/null
        echo 180000000 > /sys/class/kgsl/kgsl-3d0/devfreq/min_freq 2>/dev/null
        setprop persist.sys.unica.gpu.max_clk "700000000"
        ;;
esac

# Write status JSON response for GpuActivity
cat << EOF > "$RESP"
{"id":"$REQ_ID","ok":true,"gpuCapability":"Adreno 618 (SM7150)","currentHash":"$CUR_HASH","frequencies":[700000000,610000000,500000000,430000000,350000000,275000000,180000000,180000000,180000000,180000000],"levels":[384,320,256,192,128,64,16,16,16,16],"tables":[{"id":0,"initial_level":6,"minimum_level":0,"power_levels":[{"index":0,"frequency_hz":700000000,"rpmh_level":384,"bus_index":0,"min_bus":0,"max_bus":3,"has_acd":false,"acd":0},{"index":1,"frequency_hz":610000000,"rpmh_level":320,"bus_index":0,"min_bus":0,"max_bus":3,"has_acd":false,"acd":0},{"index":2,"frequency_hz":500000000,"rpmh_level":256,"bus_index":0,"min_bus":0,"max_bus":2,"has_acd":false,"acd":0},{"index":3,"frequency_hz":430000000,"rpmh_level":192,"bus_index":0,"min_bus":0,"max_bus":2,"has_acd":false,"acd":0},{"index":4,"frequency_hz":350000000,"rpmh_level":128,"bus_index":0,"min_bus":0,"max_bus":1,"has_acd":false,"acd":0},{"index":5,"frequency_hz":275000000,"rpmh_level":64,"bus_index":0,"min_bus":0,"max_bus":1,"has_acd":false,"acd":0},{"index":6,"frequency_hz":180000000,"rpmh_level":16,"bus_index":0,"min_bus":0,"max_bus":0,"has_acd":false,"acd":0}]}]}
EOF

chmod 0666 "$RESP" 2>/dev/null
rm -f "$REQ" 2>/dev/null
